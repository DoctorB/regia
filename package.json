{
  "name": "regia",
  "version": "0.1.0",
  "description": "Editor grafico e monitor in tempo reale per workflow multi-fase eseguiti con il Claude Agent SDK",
  "scripts": {
    "start": "npm run build && node --import tsx server/index.ts",
    "build": "vite build",
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test server/test/*.test.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.317",
    "@xyflow/react": "^12.12.1",
    "express": "^4.22.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semver": "^7.8.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoctorB/regia.git"
  }
}
